{
    "version": 2,
    "framework": null,
    "buildCommand": "",
    "installCommand": "",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4",
            "memory": 1024,
            "maxDuration": 30
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(css|js|images|img|imgdb|imgthumb|imgprofil|fonts)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/admin/(assets|dist|scss)/(.*)",
            "dest": "/public/admin/$1/$2"
        },
        {
            "src": "/(favicon.ico|robots.txt|manifest.json|sw.js|offline.html|logo-muviku.png|logo.png|splide.min.css|splide.min.js|splide-core.min.css)",
            "dest": "/public/$1"
        },
        {
            "src": "/(.*)\\.(css|js|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot|json|map)$",
            "dest": "/public/$1.$2"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "CACHE_DRIVER": "array",
        "SESSION_DRIVER": "cookie",
        "LOG_CHANNEL": "stderr",
        "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
        "DB_SSLMODE": "require"
    }
}
